generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// DATABASE_URL connects as the restricted `tenantkit_app` role (subject to RLS).
// DATABASE_MIGRATION_URL connects as the schema owner and is used only by `prisma migrate`.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}
