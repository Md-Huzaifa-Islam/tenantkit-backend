# TenantKit backend configuration.
# Copy to `.env`. Every value has a working default for local Docker, and the
# app runs with ZERO third-party keys: billing and email fall back to mock providers.

# ---------- Runtime ----------
NODE_ENV=development            # development | test | production
PORT=4000                       # API port inside the container / process
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# ---------- Database (docker compose) ----------
POSTGRES_USER=tenantkit         # schema owner (runs migrations + seed)
POSTGRES_PASSWORD=tenantkit
POSTGRES_DB=tenantkit
POSTGRES_PORT=5433              # host port mapped to Postgres
APP_DB_PASSWORD=tenantkit_app   # password for the restricted `tenantkit_app` role the API uses
API_PORT=4000                   # host port mapped to the API

# When running the API outside Docker, set these explicitly:
# DATABASE_URL=postgresql://tenantkit_app:tenantkit_app@localhost:5433/tenantkit
# DATABASE_MIGRATION_URL=postgresql://tenantkit:tenantkit@localhost:5433/tenantkit

# ---------- Auth ----------
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900      # access token lifetime (15 min)
REFRESH_TOKEN_TTL_DAYS=30       # refresh token lifetime
COOKIE_SECURE=false             # set true behind HTTPS
AUTH_RATE_LIMIT_PER_MINUTE=10   # per IP on /auth/* endpoints

# ---------- URLs ----------
APP_URL=http://localhost:3000   # web app URL, used in email links and Stripe redirects
CORS_ORIGINS=http://localhost:3000   # comma-separated allowlist
TRUST_PROXY=true                # honour X-Forwarded-For from one proxy hop

# ---------- Billing (Stripe) ----------
# Leave STRIPE_SECRET_KEY empty to use the built-in mock billing provider.
BILLING_PROVIDER=               # mock | stripe (auto-detected from STRIPE_SECRET_KEY)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=               # Stripe price id for Pro ($19/mo)
STRIPE_PRICE_BUSINESS=          # Stripe price id for Business ($49/mo)

# ---------- Email ----------
# Leave RESEND_API_KEY empty to store emails in the dev mailbox instead of sending.
EMAIL_PROVIDER=                 # mock | resend (auto-detected from RESEND_API_KEY)
RESEND_API_KEY=
EMAIL_FROM=TenantKit <no-reply@tenantkit.dev>
ENABLE_DEV_MAILBOX=true         # exposes /api/v1/dev/mailbox (never enable in real production)

# ---------- File storage (workspace logos) ----------
STORAGE_DRIVER=local            # local | s3
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE_URL=/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=                    # set for S3-compatible services (MinIO, R2)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=                  # public base URL for uploaded objects
